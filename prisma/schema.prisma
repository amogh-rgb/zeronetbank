generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// USER (Wallet Identity)
model User {
  id          String   @id @default(uuid()) @db.Uuid
  phone       String   @unique
  email       String?  @unique
  emailVerified Boolean @default(false)
  displayName String?
  publicKey   String   @unique // P-256 Hex
  pinHash     String?
  pinUpdatedAt DateTime?
  lastLoginAt DateTime?
  balance     Decimal  @default(0) @db.Decimal(18, 2)
  nonce       String   @default("") // Replay protection
  trustScore  Int      @default(100)
  isFrozen    Boolean  @default(false)
  status      String   @default("OFFLINE")
  lastSeenAt  DateTime?
  lastSyncAt  DateTime?
  deviceInfo  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sentTransactions     Transaction[] @relation("SenderUser")
  receivedTransactions Transaction[] @relation("ReceiverUser")

  @@index([status, lastSeenAt])
  @@index([email])
  @@index([createdAt])
  @@index([updatedAt])
}

// TRANSACTION (Ledger History)
model Transaction {
  id          String   @id // UUID or ULID provided by app
  from        String   // Phone or Public Key for immutable history
  to          String   // Phone or Public Key for immutable history
  fromUserId  String?  @db.Uuid
  toUserId    String?  @db.Uuid
  amount      Decimal  @db.Decimal(18, 2)
  signature   String   // Sender's signature (Hex)
  timestamp   BigInt   // Keep precision for wallet compatibility
  status      String   // PENDING, CONFIRMED, FAILED
  type        String   // TRANSFER, ADJUSTMENT, ADMIN_*
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sender      User?    @relation("SenderUser", fields: [fromUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  receiver    User?    @relation("ReceiverUser", fields: [toUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([from, timestamp])
  @@index([to, timestamp])
  @@index([fromUserId, timestamp])
  @@index([toUserId, timestamp])
  @@index([status, createdAt])
  @@index([type, createdAt])
  @@index([createdAt])
}

model BankState {
  id           Int      @id
  vaultBalance Decimal  @default(1000000) @db.Decimal(18, 2)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model EmailOtp {
  id                String   @id @default(cuid())
  email             String
  purpose           String
  otpHash           String
  expiresAt         DateTime
  attempts          Int      @default(0)
  verificationToken String?  @unique
  verifiedAt        DateTime?
  consumedAt        DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([email, purpose, expiresAt])
  @@index([verificationToken])
  @@index([consumedAt, expiresAt])
}
