generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// USER (Wallet Identity)
model User {
  id          String   @id @default(uuid()) @db.Uuid
  phone       String   @unique
  displayName String?
  publicKey   String   @unique
  balance     Decimal  @default(0) @db.Decimal(18, 2)
  nonce       String   @default("")
  trustScore  Int      @default(100)
  isFrozen    Boolean  @default(false)
  status      String   @default("OFFLINE")
  lastSeenAt  DateTime?
  lastSyncAt  DateTime?
  deviceInfo  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sentTransactions     Transaction[] @relation("SenderUser")
  receivedTransactions Transaction[] @relation("ReceiverUser")

  @@index([status, lastSeenAt])
  @@index([createdAt])
  @@index([updatedAt])
}

model Transaction {
  id          String   @id
  from        String
  to          String
  fromUserId  String?  @db.Uuid
  toUserId    String?  @db.Uuid
  amount      Decimal  @db.Decimal(18, 2)
  signature   String
  timestamp   BigInt
  status      String
  type        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sender      User?    @relation("SenderUser", fields: [fromUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  receiver    User?    @relation("ReceiverUser", fields: [toUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([from, timestamp])
  @@index([to, timestamp])
  @@index([fromUserId, timestamp])
  @@index([toUserId, timestamp])
  @@index([status, createdAt])
  @@index([type, createdAt])
  @@index([createdAt])
}

model BankState {
  id           Int      @id
  vaultBalance Decimal  @default(1000000) @db.Decimal(18, 2)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
