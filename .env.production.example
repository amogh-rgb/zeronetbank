NODE_ENV=production
PORT=3000
LOG_LEVEL=info
ADMIN_API_TOKEN=replace-with-long-random-token

DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/zeronetpay?schema=public&sslmode=require
SQLITE_DATABASE_URL=file:./dev.db

JWT_SECRET=replace-with-strong-random-secret
REFRESH_TOKEN_SECRET=replace-with-strong-random-secret

BANK_PRIVATE_KEY_HSM=false
BANK_PRIVATE_KEY_PATH=./secrets/bank-private-key.pem
BANK_PUBLIC_KEY_PATH=./secrets/bank-public-key.pem

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-gmail@gmail.com
EMAIL_PASS=your-16-char-app-password
EMAIL_FROM_NAME=ZeroNetPay

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15
OTP_EXPIRY_SECONDS=300

ENABLE_FRAUD_DETECTION=true
ENABLE_WEBSOCKET=true
ENABLE_AUDIT_LOGGING=true
