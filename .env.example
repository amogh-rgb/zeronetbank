NODE_ENV=production
PORT=10000
PUBLIC_BASE_URL=https://your-render-service.onrender.com

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key

# Email (SMTP only, backend-side)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-gmail@gmail.com
EMAIL_PASS=your-16-character-app-password
EMAIL_FROM_NAME=ZeroNetPay

# Security
JWT_SECRET=replace-with-a-random-256-bit-secret
REFRESH_TOKEN_SECRET=replace-with-a-second-random-256-bit-secret
ADMIN_SECRET=replace-with-a-secure-admin-token
USER_DASHBOARD_SECRET=replace-with-a-third-random-secret

# Optional tuning
LOG_LEVEL=info
DATABASE_CONNECT_RETRIES=5
DATABASE_CONNECT_BACKOFF_MS=3000
