{
  "name": "zero-net-bank-v2",
  "version": "2.0.0",
  "description": "Ledger Authority Backend for ZeroNetPay",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon",
    "build": "tsc",
    "start": "node dist/index.js",
    "start:prod": "npx prisma migrate deploy && node dist/index.js",
    "smoke:queue-issues": "node dev/admin_queue_issues_smoke.cjs",
    "smoke:queue-lifecycle": "node dev/admin_queue_issues_smoke.cjs",
    "smoke:admin-flow": "node dev/admin_happy_path_smoke.cjs",
    "prisma:generate": "prisma generate",
    "prisma:generate:sqlite": "prisma generate --schema prisma/schema.sqlite.prisma",
    "prisma:generate:pg": "prisma generate --schema prisma/schema.postgres.prisma",
    "prisma:push": "prisma db push",
    "prisma:migrate:dev": "prisma migrate dev --name init_postgres",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:migrate:pg": "prisma migrate dev --schema prisma/schema.postgres.prisma --name init_postgres",
    "prisma:studio": "prisma studio",
    "db:migrate:sqlite-to-postgres": "ts-node scripts/migrate-sqlite-to-postgres.ts",
    "backup": "node -e \"const os=require('os'); os.platform()==='win32' ? require('child_process').execSync('scripts\\\\backup.bat',{stdio:'inherit'}) : require('child_process').execSync('bash scripts/backup.sh',{stdio:'inherit'})\"",
    "test": "jest"
  },
  "dependencies": {
    "@prisma/client": "^5.10.2",
    "@supabase/supabase-js": "^2.39.0",
    "bignumber.js": "^9.1.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "elliptic": "^6.5.5",
    "express": "^4.18.2",
    "express-rate-limit": "^8.2.1",
    "helmet": "^7.1.0",
    "lru-cache": "^10.2.0",
    "nodemailer": "^6.9.13",
    "prisma": "^5.10.2",
    "winston": "^3.19.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/elliptic": "^6.4.18",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.24",
    "@types/nodemailer": "^6.4.14",
    "jest": "^29.7.0",
    "nodemon": "^3.1.0",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
